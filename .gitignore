# ============================================
# 价格比对项目 .gitignore
# 作用：下面列出的文件/文件夹，永远不会被 git 上传到 GitHub
# ============================================

# ---------- 环境变量与密钥（最重要！）----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets.json
secrets.*
config.local.*
credentials.*

# ---------- 依赖目录（体积巨大，绝不能上传）----------
node_modules/
vendor/
bower_components/
.pnp
.pnp.*

# ---------- 本地数据库 ----------
*.sqlite
*.sqlite3
*.db
*.db3
*.mdb
data/*.db
*.sql.gz

# ---------- 日志与缓存 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.temp/
tmp/

# ---------- 构建产物 ----------
dist/
build/
.next/
out/
*.min.js

# ---------- 编辑器与系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Python（备用，以后可能用）----------
__pycache__/
*.py[cod]
venv/
.venv/
env/

# ---------- 个人笔记（不公开）----------
notes/private/
*.private.md

# ---------- AI 工作记录目录（非项目产物，不上传）----------
.workbuddy-ai/
